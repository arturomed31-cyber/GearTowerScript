-- Función auxiliar para escribir comandos en el chat
local function enviarAlChat(mensaje)
   if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
      local canales = TextChatService:FindFirstChild("TextChannels")
      local canalGeneral = canales and canales:FindFirstChild("RBXGeneral")
      if canalGeneral then
         canalGeneral:SendAsync(mensaje)
         return
      end
   end

   local chatEvents = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
   local sayMessage = chatEvents and chatEvents:FindFirstChild("SayMessageRequest")
   if sayMessage then
      sayMessage:FireServer(mensaje, "All")
   end
end

