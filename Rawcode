local BombSection = Tab:CreateSection("Bomb Player")

local jugadorObjetivo = nil

local function obtenerListaJugadores()
   local lista = {"None"}
   for _, player in ipairs(Players:GetPlayers()) do
      if player ~= Players.LocalPlayer then
         table.insert(lista, player.Name)
      end
   end
   return lista
end

local PlayerDropdown = Tab:CreateDropdown({
   Name = "Select Player",
   Options = obtenerListaJugadores(),
   CurrentOption = {"None"},
   MultipleOptions = false,
   Flag = "DropdownJugador",
   Callback = function(Options)
      local nombreSeleccionado = type(Options) == "table" and table.concat(Options) or tostring(Options)
      if nombreSeleccionado == "" or nombreSeleccionado == "None" then
         jugadorObjetivo = nil
      else
         jugadorObjetivo = Players:FindFirstChild(nombreSeleccionado)
      end
   end,
})

local BombButton = Tab:CreateButton({
   Name = "Bomb Player (28s)",
   Callback = function()
      if not jugadorObjetivo then
         Rayfield:Notify({
            Title = "Error",
            Content = "Select a valid player first.",
            Duration = 3,
            Image = 4483362458,
         })
         return
      end

      local localPlayer = Players.LocalPlayer
      local character = localPlayer.Character
      local hrp = character and character:FindFirstChild("HumanoidRootPart")
      if not hrp then return end

      local remote = ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("mapManagerRemote")
      local objetivoActual = jugadorObjetivo

      local bombTool = localPlayer.Backpack:FindFirstChild("Classic Timebomb") or character:FindFirstChild("Classic Timebomb")
      if not bombTool then
         remote:FireServer("claimTool", "Classic Timebomb")
         bombTool = localPlayer.Backpack:WaitForChild("Classic Timebomb", 3)
      end

      if not bombTool then
         Rayfield:Notify({
            Title = "Cooldown",
            Content = "Could not claim Classic Timebomb (server cooldown).",
            Duration = 3,
            Image = 4483362458,
         })
         return
      end

      bombTool.Parent = character
      Rayfield:Notify({
         Title = "Bomb Claimed",
         Content = "Waiting 28s before dropping it on " .. objetivoActual.Name .. "...",
         Duration = 4,
         Image = 4483362458,
      })

      task.wait(28)

      character = localPlayer.Character
      hrp = character and character:FindFirstChild("HumanoidRootPart")
      if not hrp or not objetivoActual or not objetivoActual.Parent or not objetivoActual.Character or not objetivoActual.Character:FindFirstChild("HumanoidRootPart") then
         Rayfield:Notify({
            Title = "Error",
            Content = "Target or you died before the 28s finished.",
            Duration = 3,
            Image = 4483362458,
         })
         return
      end

      local posOriginal = hrp.CFrame

      if bombTool and bombTool.Parent ~= character then
         bombTool.Parent = character
      end

      hrp.CFrame = objetivoActual.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 2)
      task.wait(0.1)
      
      if bombTool then
         bombTool:Activate()
      end
      
      task.wait(0.2)
      hrp.CFrame = posOriginal
   end,
})

Players.PlayerAdded:Connect(function()
