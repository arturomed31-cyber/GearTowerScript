local function obtenerHDCommandRemote()
   local hdClient = ReplicatedStorage:FindFirstChild("HDAdminClient")
   local signals = hdClient and hdClient:FindFirstChild("Signals")
   local req = signals and signals:FindFirstChild("RequestCommand")
   if req then return req end

   for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
      if obj.Name == "RequestCommand" and (obj:IsA("RemoteFunction") or obj:IsA("RemoteEvent")) then
         return obj
      end
   end
   return nil
end

local function ejecutarComandoHD(comando)
   local reqRemote = obtenerHDCommandRemote()
   if reqRemote then
      task.spawn(function()
         if reqRemote:IsA("RemoteFunction") then
            reqRemote:InvokeServer(comando)
         else
            reqRemote:FireServer(comando)
         end
      end)
      return true
   else
      enviarAlChat(comando)
      return false
   end
end

local function crearBotonComandoMasivo(nombreBoton, textoPausa, textoReanudar, construirComando)
   local activo = false
   local indice = 1
   local listaObjetivos = {}
   local boton

   boton = Tab:CreateButton({
      Name = nombreBoton,
      Callback = function()
         if activo then
            activo = false
            boton:Set(string.format("%s (%d/%d)", textoReanudar, indice - 1, #listaObjetivos))
            Rayfield:Notify({
               Title = "Paused",
               Content = "Paused! Click again to resume.",
               Duration = 2,
               Image = 4483362458,
            })
            return
         end

         if indice == 1 or indice > #listaObjetivos then
            listaObjetivos = {}
            for _, player in ipairs(Players:GetPlayers()) do
               if player ~= Players.LocalPlayer then
                  table.insert(listaObjetivos, player)
               end
            end
            indice = 1
         end

         if #listaObjetivos == 0 then
            Rayfield:Notify({
               Title = "Info",
               Content = "No other players in the server.",
               Duration = 2,
               Image = 4483362458,
            })
            return
         end

         activo = true
         task.spawn(function()
            while activo and indice <= #listaObjetivos do
               local target = listaObjetivos[indice]
               boton:Set(string.format("%s (%d/%d)", textoPausa, indice, #listaObjetivos))

               if target and target.Parent then
                  ejecutarComandoHD(construirComando(target.Name))
                  indice = indice + 1
                  task.wait(1) -- Exactamente 1 jugador por segundo
               else
                  indice = indice + 1
               end
            end

            if indice > #listaObjetivos then
               activo = false
               indice = 1
               listaObjetivos = {}
               boton:Set(nombreBoton)
               Rayfield:Notify({
                  Title = "Grief Complete",
                  Content = "Finished: " .. nombreBoton,
                  Duration = 3,
                  Image = 4483362458,
               })
            end
         end)
      end,
   })
end

